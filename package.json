{
  "name": "hot-cross-buns",
  "version": "5.0.1",
  "private": true,
  "description": "Keyboard-first browser planner with an IndexedDB workspace.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "corepack pnpm typecheck && corepack pnpm typecheck:core && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "test": "corepack pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:smoke": "corepack pnpm build && corepack pnpm test:ui",
    "test:release-gate": "corepack pnpm build && corepack pnpm test:production && corepack pnpm test:offline && corepack pnpm test:unit && corepack pnpm test:db && corepack pnpm test:ui",
    "test:db": "node scripts/run-core-store-tests.mjs",
    "test:security": "vitest run --config vitest.config.ts src/main/**/*.test.ts src/preload/**/*.test.ts",
    "test:ui": "node scripts/run-ui-tests.mjs",
    "test:validate": "corepack pnpm test:release-gate",
    "preview": "vite preview",
    "measure:storage": "node scripts/measure-browser-storage.mjs",
    "test:production": "node scripts/check-web-build.mjs",
    "test:offline": "node scripts/check-offline-build.mjs"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.59.20",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "loading-dev": "^0.3.4",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.15.0",
    "motion": "^12.23.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rrule": "2.8.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "7.0.3",
    "electron": "^33.2.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "shadcn": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "better-sqlite3": "^12.10.0"
  }
}
