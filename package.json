{
  "name": "hot-cross-buns",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "sync:check": "node --experimental-strip-types scripts/check-sync-folder.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_google_*.py'",
    "test:ui": "playwright test",
    "test:e2e": "npm run build && npm run test:ui",
    "test:local": "npm run test:e2e",
    "verify": "npm run test:unit && npm run test:python && npm run build && npm run test:ui && npm audit --audit-level=low"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "styled-components": "^6.3.9",
    "unified": "^11.0.5"
  },
  "overrides": {
    "esbuild": "npm:esbuild-wasm@^0.25.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  }
}
