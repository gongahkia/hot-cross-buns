{
  "name": "hot-cross-buns",
  "version": "5.0.1",
  "private": true,
  "description": "Keyboard-first desktop planner for tasks, calendars, notes, and local agent workflows.",
  "main": "out/main/index.js",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "corepack pnpm typecheck && corepack pnpm typecheck:core && corepack pnpm exec electron-vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "test": "corepack pnpm test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:smoke": "corepack pnpm build && corepack pnpm exec playwright test -c playwright.config.ts",
    "test:smoke:1k": "HCB_PERF_COUNT=1000 corepack pnpm test:perf",
    "test:smoke:5k": "HCB_PERF_COUNT=5000 corepack pnpm test:perf",
    "test:smoke:10k": "HCB_PERF_COUNT=10000 corepack pnpm test:perf",
    "test:live-google": "corepack pnpm build && corepack pnpm exec playwright test --config playwright.live-google.config.ts",
    "test:perf": "corepack pnpm build && tsx scripts/perf-smoke.ts",
    "test:release-gate": "corepack pnpm build && corepack pnpm test:unit && corepack pnpm test:db && corepack pnpm exec playwright test -c playwright.config.ts",
    "test:db": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.config.ts src/main/services/coreStore.test.ts",
    "test:security": "vitest run --config vitest.config.ts src/main/**/*.test.ts src/preload/**/*.test.ts"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.59.20",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "loading-dev": "^0.3.4",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.15.0",
    "motion": "^12.23.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "shadcn": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
