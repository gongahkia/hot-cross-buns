{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noImplicitAny": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/shared/**/*.ts",
    "src/browser/**/*.ts",
    "src/renderer/src/vite-env.d.ts"
  ],
  "exclude": [
    "src/main/**/*.test.ts",
    "src/browser/**/*.test.ts"
  ]
}
