Screen {
    background: $background;
    color: $foreground;
    layers: base overlay;
}

/* Keep recovery and confirmation overlays centered at every terminal size. */
ModalScreen {
    align: center middle;
    background: $footer-background;
}

#topbar {
    height: 3;
    padding: 1 2 0 2;
    background: $background;
    color: $foreground;
    border-bottom: ascii $border;
    text-style: bold;
}

#tabs {
    height: 3;
    padding: 0 1;
    background: $background;
    border-bottom: ascii $border;
}

Button {
    min-width: 10;
    height: 3;
    padding: 0 1;
    background: $boost;
    color: auto 87%;
    border: ascii $border;
}

Button.-primary {
    background: $primary;
    color: auto 87%;
    border: ascii $primary;
}

Button.-success {
    background: $success;
    color: auto 87%;
    border: ascii $success;
}

Button.-warning {
    background: $warning;
    color: auto 87%;
    border: ascii $warning;
}

Button.-error {
    background: $error;
    color: auto 87%;
    border: ascii $error;
}

Button:hover {
    background: $boost;
    border: ascii $primary;
    text-style: bold underline;
}

Button.-primary:hover {
    background: $primary;
}

Button.-success:hover {
    background: $success;
}

Button.-warning:hover {
    background: $warning;
}

Button.-error:hover {
    background: $error;
}

Button:focus, Input:focus, TextArea:focus, ListView:focus {
    outline: ascii $primary;
}

#tabs Button {
    min-width: 10;
}

#workspace {
    height: 1fr;
}

#sidebar {
    width: 27;
    min-width: 22;
    background: $panel;
    color: auto 87%;
}

.sidebar-hidden #sidebar, .sidebar-hidden .column-resize-handle {
    display: none;
}

.column-resize-handle {
    width: 1;
    min-width: 1;
    height: 1fr;
    border-left: ascii $border;
    background: $panel;
}

.column-resize-handle:hover {
    border-left: ascii $primary;
}

#mini-month {
    height: 10;
    padding: 0 1;
    color: $text-muted;
}

#mini-month-title, #mini-month-weekdays {
    height: 1;
    content-align: center middle;
    color: $text-muted;
}

.mini-month-week {
    height: 1;
}

#mini-month Button.mini-day {
    width: 1fr;
    min-width: 0;
    height: 1;
    padding: 0;
    border: none;
    background: transparent;
    color: $text-muted;
    content-align: center middle;
}

#mini-month Button.mini-day:hover {
    text-style: underline;
}

#mini-month Button.mini-day.mini-day-selected {
    color: auto 87%;
    text-style: bold reverse;
}

#mini-month Button.mini-day:focus {
    outline: none;
    text-style: underline;
}

.section-title {
    height: 3;
    padding: 1;
    text-style: bold;
    color: auto 87%;
}

#surface-title {
    height: 3;
    padding: 1;
    text-style: bold;
    color: $foreground;
}

#resources {
    height: 1fr;
    background: $panel;
    color: auto 87%;
}

#sync-state {
    height: 3;
    padding: 1;
    color: $text-muted;
}

#center {
    width: 1fr;
    min-width: 28;
    background: $background;
}

#content {
    height: 1fr;
    padding: 0 1;
    overflow-x: auto;
    background: $background;
}

#calendar-content {
    height: 1fr;
    padding: 0 1;
    overflow: auto;
    background: $background;
    color: $foreground;
    display: none;
}

#content > ListItem {
    width: auto;
    min-width: 100%;
}

#content > ListItem Label {
    width: auto;
    text-wrap: nowrap;
}

WorkspaceTable {
    background: $background;
    color: $foreground;
}

ListView > ListItem {
    padding: 0 1;
    background: transparent;
    color: auto 87%;
}

#resources > ListItem {
    background: transparent;
    color: auto 87%;
}

ListView > ListItem.--highlight {
    background: transparent;
    color: auto 87%;
    outline: ascii $primary;
    text-style: bold underline;
}

Input, TextArea {
    background: $boost;
    color: auto 87%;
    border: ascii $border;
}

/* Make text entry unambiguous even when the terminal profile uses defaults. */
.theme-terminal Input > .input--cursor, .theme-mono Input > .input--cursor,
.theme-terminal TextArea .text-area--cursor, .theme-mono TextArea .text-area--cursor {
    background: ansi_white;
    color: ansi_black;
    text-style: none;
}

.theme-dark Input > .input--cursor, .theme-light Input > .input--cursor,
.theme-dark TextArea .text-area--cursor, .theme-light TextArea .text-area--cursor {
    background: $foreground;
    color: $background;
    text-style: none;
}

Input.-invalid, TextArea.-invalid {
    background: $boost;
    color: auto 87%;
    border: ascii $error;
}

.density-comfortable ListView > ListItem {
    height: 2;
    padding-top: 1;
}

.density-compact ListView > ListItem {
    height: 1;
}

.borders-unicode Button, .borders-unicode Input, .borders-unicode TextArea,
.borders-unicode #palette-dialog, .borders-unicode #editor-dialog,
.borders-unicode #confirm-dialog, .borders-unicode #event-dialog,
.borders-unicode #recurrence-dialog,
.borders-unicode #rsvp-dialog, .borders-unicode #calendar-dialog,
.borders-unicode #settings-dialog, .borders-unicode #find-time-dialog,
.borders-unicode #google-setup-dialog, .borders-unicode #batch-move-dialog,
.borders-unicode #batch-action-dialog, .borders-unicode #batch-move-preview,
.borders-unicode #batch-action-preview, .borders-unicode #item-view-dialog {
    border: round $border;
}

.borders-unicode #topbar, .borders-unicode #tabs {
    border: none;
    border-bottom: solid $border;
}

.borders-unicode .column-resize-handle {
    border: none;
    border-left: solid $border;
}

.focus-ascii Button:focus, .focus-ascii Input:focus, .focus-ascii TextArea:focus,
.focus-ascii ListView:focus, .focus-ascii ListView > ListItem.--highlight {
    outline: ascii $primary;
    text-style: bold underline;
}

.focus-underline Button:focus, .focus-underline Input:focus, .focus-underline TextArea:focus,
.focus-underline ListView:focus, .focus-underline ListView > ListItem.--highlight {
    outline: none;
    text-style: bold underline;
}

.focus-reverse Button:focus, .focus-reverse Input:focus, .focus-reverse TextArea:focus,
.focus-reverse ListView:focus, .focus-reverse ListView > ListItem.--highlight {
    outline: none;
    text-style: reverse;
}

/* Keep the active workspace item visible after focus moves elsewhere. */

#palette-dialog, #help-dialog, #editor-dialog, #confirm-dialog, #event-dialog,
#rsvp-dialog, #calendar-dialog, #settings-dialog, #find-time-dialog, #loading-dialog,
#onboarding-dialog, #google-setup-dialog, #schedule-dialog, #bulk-dialog,
#batch-move-dialog, #batch-action-dialog, #import-dialog, #conflict-dialog,
#item-view-dialog {
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: ascii $border;
    background: $surface;
}

#palette-dialog {
    height: 25;
}

.calendar-overflow-dialog {
    height: 20;
}

#calendar-overflow-items {
    height: 1fr;
}

#event-dialog, #calendar-dialog, #find-time-dialog {
    height: 30;
}

#recurrence-dialog {
    width: 52;
    height: 24;
    max-height: 90%;
}

#event-fields, #item-view-content {
    height: 1fr;
}

#event-description {
    height: 7;
}

.event-field-label, #event-recurrence-summary, #event-location-map {
    height: auto;
    color: $text-muted;
}

#event-recurrence-summary {
    padding: 0 1;
}

.recurrence-row {
    height: 3;
    align: left middle;
}

.recurrence-label {
    width: 14;
    min-width: 14;
}

.recurrence-row Input {
    width: 7;
    min-width: 7;
    margin-right: 1;
}

#recurrence-weekdays {
    height: 3;
}

#recurrence-weekdays Button {
    width: 1fr;
    min-width: 4;
    padding: 0;
}

#recurrence-weekdays Button.recurrence-weekday-selected {
    background: $primary;
    color: auto 87%;
    border: ascii $primary;
}

#event-location-map {
    padding: 0 1;
}

#settings-dialog {
    height: 35;
    max-height: 90%;
}

#settings-fields {
    height: 1fr;
}

#onboarding-dialog {
    height: 31;
    max-height: 90%;
}

#google-setup-dialog {
    height: 28;
    max-height: 90%;
}

#google-setup-content {
    height: 1fr;
}

#onboarding-fields {
    height: 1fr;
}

.onboarding-field {
    height: 3;
}

.onboarding-credential-field {
    height: 4;
}

#onboard-env-editor-hint {
    height: 1;
    margin-left: 24;
    padding: 0 1;
    color: $text-muted;
}

#import-editor-hint {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

.onboarding-field Label {
    width: 24;
    padding-top: 1;
    color: $text-muted;
}

.onboarding-field Input,
.onboarding-field Select {
    width: 1fr;
}

.settings-pair {
    height: 3;
}

.settings-pair Input, .settings-pair Select {
    width: 1fr;
}

.due-date-fields {
    height: 3;
}

.due-date-fields Select {
    width: 1fr;
}

#loading-dialog {
    width: 38;
    min-height: 7;
    align: center middle;
}

#rattles-loader, #loading-message, #loading-cancel-hint {
    width: 1fr;
    content-align: center middle;
}

#settings-colors-label {
    height: 1;
    color: $text-muted;
}

#settings-colors {
    height: 4;
}

EmojiCompletion {
    layer: overlay;
    position: absolute;
    offset: 2 1;
    width: 32;
    height: auto;
    padding: 0 1;
    border: ascii $primary;
    background: $surface;
    color: $foreground;
}

#rsvp-dialog {
    width: 40;
}

#batch-move-dialog {
    height: 28;
}

#batch-action-dialog {
    height: 28;
}

#batch-move-preview, #batch-action-preview {
    height: 1fr;
    margin-top: 1;
    border: ascii $border;
    padding: 0 1;
}

#palette-results {
    height: 1fr;
}

#calendar-list, #find-results {
    height: 1fr;
}

#dialog-title {
    height: 2;
    text-style: bold;
}

#item-view-dialog {
    height: 32;
}

#help-dialog {
    width: 62;
    height: 32;
}

#help-content {
    padding: 0 1;
}

#item-view-content {
    padding: 0 1;
}

#item-view-title {
    height: auto;
    margin-bottom: 1;
    text-style: bold;
}

.item-view-section {
    height: auto;
    margin-top: 1;
}

.item-view-location {
    height: auto;
    margin-top: 1;
}

#editor-notes {
    height: 8;
}

.dialog-buttons {
    height: 3;
    align-horizontal: right;
}

.dialog-buttons Button {
    margin-left: 1;
}

Footer {
    background: $background;
    color: $foreground;
    border-top: ascii $border;
}

.narrow #sidebar {
    width: 22;
}

.narrow #tabs Button {
    min-width: 8;
}

.very-narrow #sidebar {
    display: none;
}

.very-narrow #sidebar-resize {
    display: none;
}

.very-narrow #tabs Button {
    min-width: 6;
    padding: 0;
}
