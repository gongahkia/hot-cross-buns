{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hot-cross-buns.dev/schemas/config/v1/hcb-config-v1.schema.json",
  "title": "HCB configuration v1",
  "description": "Strict JSON configuration for Hot Cross Buns. Omitted sections use application defaults.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "preferences": { "$ref": "#/$defs/preferences" },
    "theme": { "$ref": "#/$defs/theme" },
    "keys": { "$ref": "#/$defs/keys" }
  },
  "$defs": {
    "color": {
      "type": "string",
      "minLength": 1,
      "description": "A Textual color value, including ansi_default or transparent."
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": { "type": "string" },
        "keymap": { "type": "string" },
        "editor": { "type": "string", "minLength": 1 },
        "week_starts_on": { "type": "integer", "minimum": 0, "maximum": 6 },
        "default_account_id": { "type": ["string", "null"] },
        "default_task_list_id": { "type": ["string", "null"] },
        "default_calendar_id": { "type": ["string", "null"] },
        "reminders_enabled": { "type": "boolean" },
        "reminder_catch_up_minutes": { "type": "integer", "minimum": 0 },
        "reminder_poll_seconds": { "type": "integer", "minimum": 1 },
        "reminder_jitter_seconds": { "type": "integer", "minimum": 0 },
        "reminder_sync_interval_minutes": { "type": "integer", "minimum": 0 },
        "reminder_sync_mode": { "enum": ["all", "pull", "off"] },
        "time_zone": { "type": "string", "minLength": 1 }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": { "enum": ["terminal", "dark", "light"] },
        "preset": { "type": ["string", "null"], "minLength": 1 },
        "density": { "enum": ["compact", "comfortable"] },
        "borders": { "enum": ["ascii", "unicode"] },
        "focus": { "enum": ["ascii", "underline", "reverse"] },
        "mouse": { "type": "boolean" },
        "loader": { "$ref": "#/$defs/loader" },
        "colors": { "$ref": "#/$defs/colors" }
      }
    },
    "loader": {
      "type": "string",
      "enum": [
        "arrows.arrow", "arrows.double_arrow",
        "ascii.dqpb", "ascii.rolling_line", "ascii.simple_dots", "ascii.simple_dots_scrolling", "ascii.arc", "ascii.balloon", "ascii.circle_halves", "ascii.circle_quarters", "ascii.point", "ascii.square_corners", "ascii.toggle", "ascii.triangle", "ascii.grow_horizontal", "ascii.grow_vertical", "ascii.noise",
        "braille.dots", "braille.dots2", "braille.dots3", "braille.dots4", "braille.dots5", "braille.dots6", "braille.dots7", "braille.dots8", "braille.dots9", "braille.dots10", "braille.dots11", "braille.dots12", "braille.dots13", "braille.dots14", "braille.sand", "braille.bounce", "braille.dots_circle", "braille.wave", "braille.scan", "braille.rain", "braille.pulse", "braille.snake", "braille.sparkle", "braille.cascade", "braille.columns", "braille.orbit", "braille.breathe", "braille.waverows", "braille.checkerboard", "braille.helix", "braille.fillsweep", "braille.diagswipe", "braille.infinity",
        "emoji.hearts", "emoji.clock", "emoji.earth", "emoji.moon", "emoji.speaker", "emoji.weather"
      ]
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "panel": { "$ref": "#/$defs/color" },
        "overlay": { "$ref": "#/$defs/color" },
        "control": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" },
        "muted": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "focus": { "$ref": "#/$defs/color" },
        "selection": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "success": { "$ref": "#/$defs/color" },
        "warning": { "$ref": "#/$defs/color" },
        "danger": { "$ref": "#/$defs/color" }
      }
    },
    "keys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quit": { "type": "string" },
        "help": { "type": "string" },
        "search": { "type": "string" },
        "sync": { "type": "string" },
        "create": { "type": "string" },
        "edit": { "type": "string" },
        "delete": { "type": "string" },
        "complete": { "type": "string" },
        "external_editor": { "type": "string" }
      }
    }
  }
}
