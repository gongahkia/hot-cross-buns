{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hot-cross-buns.dev/schemas/config/v2/hcb-config-v2.schema.json",
  "title": "HCB configuration v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "active_profile": { "type": ["string", "null"], "minLength": 1 },
    "preferences": { "$ref": "#/$defs/preferences" },
    "theme": { "$ref": "#/$defs/theme" },
    "keys": { "$ref": "#/$defs/keys" },
    "tui": { "$ref": "#/$defs/tui" }
  },
  "$defs": {
    "color": { "type": "string", "minLength": 1 },
    "role": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "color": { "type": ["string", "null"], "minLength": 1 },
        "background": { "type": ["string", "null"], "minLength": 1 },
        "text_style": { "type": "string", "minLength": 1 }
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "default_event_duration_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "remove_recognized_text": { "type": "boolean" },
        "task_aliases": { "$ref": "#/$defs/strings" },
        "event_aliases": { "$ref": "#/$defs/strings" },
        "high_priority_aliases": { "$ref": "#/$defs/strings" },
        "medium_priority_aliases": { "$ref": "#/$defs/strings" },
        "low_priority_aliases": { "$ref": "#/$defs/strings" }
      }
    },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "preferences": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "theme": { "type": "string" }, "keymap": { "type": "string" },
        "editor": { "type": "string", "minLength": 1 }, "week_starts_on": { "type": "integer", "minimum": 0, "maximum": 6 },
        "default_account_id": { "type": ["string", "null"] }, "default_task_list_id": { "type": ["string", "null"] },
        "default_calendar_id": { "type": ["string", "null"] }, "reminders_enabled": { "type": "boolean" },
        "reminder_catch_up_minutes": { "type": "integer", "minimum": 0 }, "reminder_poll_seconds": { "type": "integer", "minimum": 1 },
        "reminder_jitter_seconds": { "type": "integer", "minimum": 0 }, "reminder_sync_interval_minutes": { "type": "integer", "minimum": 0 },
        "reminder_sync_mode": { "enum": ["all", "pull", "off"] }, "time_zone": { "type": "string", "minLength": 1 },
        "date_time_format": { "enum": ["friendly", "friendly_24h", "iso"] }, "capture": { "$ref": "#/$defs/capture" }
      }
    },
    "theme": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "profile": { "enum": ["terminal", "dark", "light"] }, "preset": { "type": ["string", "null"], "minLength": 1 },
        "density": { "enum": ["compact", "comfortable"] }, "borders": { "enum": ["ascii", "unicode"] },
        "focus": { "enum": ["ascii", "underline", "reverse"] }, "mouse": { "type": "boolean" },
        "loader": { "type": "string", "minLength": 1 }, "stylesheet": { "type": ["string", "null"], "minLength": 1 },
        "colors": { "$ref": "#/$defs/colors" },
        "roles": {
          "type": "object", "additionalProperties": false,
          "properties": { "completed_item": { "$ref": "#/$defs/role" }, "selected_item": { "$ref": "#/$defs/role" }, "link": { "$ref": "#/$defs/role" }, "modal_title": { "$ref": "#/$defs/role" } }
        }
      }
    },
    "colors": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "background": { "$ref": "#/$defs/color" }, "surface": { "$ref": "#/$defs/color" }, "panel": { "$ref": "#/$defs/color" }, "overlay": { "$ref": "#/$defs/color" },
        "control": { "$ref": "#/$defs/color" }, "text": { "$ref": "#/$defs/color" }, "muted": { "$ref": "#/$defs/color" }, "border": { "$ref": "#/$defs/color" },
        "focus": { "$ref": "#/$defs/color" }, "selection": { "$ref": "#/$defs/color" }, "accent": { "$ref": "#/$defs/color" }, "success": { "$ref": "#/$defs/color" },
        "warning": { "$ref": "#/$defs/color" }, "danger": { "$ref": "#/$defs/color" }
      }
    },
    "keys": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "tui": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "initial_surface": { "enum": ["Tasks", "Notes", "Agenda", "Day", "Week", "Month"] }, "sidebar_visible": { "type": "boolean" }, "sidebar_width": { "type": "integer", "minimum": 22, "maximum": 60 },
        "agenda_days": { "type": "integer", "minimum": 1, "maximum": 31 }, "task_show_due": { "type": "boolean" }, "notes_show_preview": { "type": "boolean" },
        "agenda_show_calendar": { "type": "boolean" }, "agenda_show_location": { "type": "boolean" }
      }
    }
  }
}
