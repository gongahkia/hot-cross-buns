class Wukong < Formula
  desc "Reproducible package manager for Godot 4 addons"
  homepage "https://github.com/gongahkia/wukong"
  url "https://github.com/gongahkia/wukong/archive/refs/tags/v@VERSION@.tar.gz"
  sha256 "@SOURCE_SHA256@"
  license "MIT"

  depends_on "rust" => :build

  def install
    system "cargo", "install", *std_cargo_args(path: "crates/wukong-cli")
  end

  test do
    assert_equal "wukong @VERSION@", shell_output("#{bin}/wukong --version").strip
  end
end
