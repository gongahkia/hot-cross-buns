NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://hot_cross_buns:replace-me@127.0.0.1:5432/hot_cross_buns
# For local Vite development these may be http://127.0.0.1:8787 and http://127.0.0.1:5173.
# For the reliable self-hosted stack both must be exactly the same public HTTPS origin.
HCB_PUBLIC_ORIGIN=http://127.0.0.1:8787
HCB_FRONTEND_ORIGINS=http://127.0.0.1:5173
HCB_GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
HCB_GOOGLE_CLIENT_SECRET=replace-with-a-server-only-secret
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
HCB_ENCRYPTION_KEYS=primary:replace-with-32-byte-base64-key
HCB_ACTIVE_ENCRYPTION_KEY_ID=primary
HCB_SESSION_TTL_DAYS=30
# The same-origin deployment uses lax cookies.
HCB_SESSION_SAME_SITE=lax
# Set true only in a self-hosted reliable deployment. This enables the PostgreSQL mirror,
# five-minute polling worker, and Web Push endpoints.
HCB_RELIABLE_SYNC_ENABLED=false
# Generate with: npx web-push generate-vapid-keys
# HCB_VAPID_SUBJECT=mailto:admin@example.com
# HCB_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
# HCB_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
# Optional HTTPS same-origin Google Calendar watch target. Polling still remains enabled.
# HCB_GOOGLE_CALENDAR_WEBHOOK_URL=https://calendar.example.com/api/webhooks/google/calendar
